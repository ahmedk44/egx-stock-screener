# ============================================================
# EGX Screener - Environment variables template
# Copy this file to .env and fill in real values (local testing).
# In GitHub Actions, set these as repository Secrets instead.
# ============================================================

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAH...your-bot-token

# Multi-Channel Routing: one public channel per strategy type.
# Signals are routed dynamically: Scalping -> SCALPING channel, Swing -> SWING,
# Investment -> INVESTMENT. IDs must include the minus sign for private channels.
# Get each channel's ID by sending a test message and hitting
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHANNEL_SCALPING=-1001234567890
TELEGRAM_CHANNEL_SWING=-1001234567890
TELEGRAM_CHANNEL_INVESTMENT=-1001234567890

# Legacy fallback names (optional - checked only when the vars above are unset)
# CHANNEL_SCALPING=-1001234567890
# CHANNEL_SWING=-1001234567890
# CHANNEL_INVESTMENT=-1001234567890

# Supabase (user_portfolio + sent_alerts + active_positions)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-key

# Google AI Studio / Gemini API key (https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key
