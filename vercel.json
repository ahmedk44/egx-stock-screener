{
  "functions": {
    "api/webhook.py": {
      "runtime": "@vercel/python@3.9.0"
    },
    "api/pre_market.py": {
      "runtime": "@vercel/python@3.9.0"
    },
    "api/post_market.py": {
      "runtime": "@vercel/python@3.9.0"
    },
    "api/scanner.py": {
      "runtime": "@vercel/python@3.9.0"
    }
  },
  "rewrites": [
    {
      "source": "/api/webhook",
      "destination": "/api/webhook.py"
    },
    {
      "source": "/api/pre_market",
      "destination": "/api/pre_market.py"
    },
    {
      "source": "/api/post_market",
      "destination": "/api/post_market.py"
    },
    {
      "source": "/api/scanner",
      "destination": "/api/scanner.py"
    }
  ],
  "crons": [
    {
      "path": "/api/pre_market",
      "schedule": "30 5 * * 0-4"
    },
    {
      "path": "/api/post_market",
      "schedule": "30 12 * * 0-4"
    }
  ]
}
