{
  "builds": [
    {
      "src": "api/webhook.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/pre_market.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60
      }
    },
    {
      "src": "api/post_market.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60
      }
    },
    {
      "src": "api/scanner.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "/api/webhook",
      "dest": "api/webhook.py"
    },
    {
      "src": "/api/pre_market",
      "dest": "api/pre_market.py"
    },
    {
      "src": "/api/post_market",
      "dest": "api/post_market.py"
    },
    {
      "src": "/api/scanner",
      "dest": "api/scanner.py"
    }
  ],
  "crons": [
    {
      "path": "/api/pre_market",
      "schedule": "30 5 * * 0-4"
    },
    {
      "path": "/api/post_market",
      "schedule": "30 12 * * 0-4"
    }
  ]
}
