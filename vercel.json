{
  "functions": {
    "api/webhook.py": {
      "runtime": "@vercel/python@3.9"
    },
    "api/cron/pre_market.py": {
      "runtime": "@vercel/python@3.9"
    },
    "api/cron/post_market.py": {
      "runtime": "@vercel/python@3.9"
    },
    "api/cron/scanner.py": {
      "runtime": "@vercel/python@3.9"
    }
  },
  "rewrites": [
    {
      "source": "/api/webhook",
      "destination": "/api/webhook.py"
    },
    {
      "source": "/api/cron/pre_market",
      "destination": "/api/cron/pre_market.py"
    },
    {
      "source": "/api/cron/post_market",
      "destination": "/api/cron/post_market.py"
    },
    {
      "source": "/api/cron/scanner",
      "destination": "/api/cron/scanner.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/pre_market",
      "schedule": "30 5 * * 0-4"
    },
    {
      "path": "/api/cron/scanner",
      "schedule": "*/15 7-11 * * 0-4"
    },
    {
      "path": "/api/cron/post_market",
      "schedule": "30 12 * * 0-4"
    }
  ]
}
